generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                  String               @id @default(uuid()) @db.Uuid
  nome                String               @db.VarChar(255)
  email               String               @unique @db.VarChar(255)
  senhaHash           String               @map("senha_hash") @db.VarChar(255)
  tipo                TipoUsuario
  telefone            String?              @db.VarChar(20)
  status              StatusUsuario        @default(ATIVO)
  criadoEm            DateTime             @default(now()) @map("criado_em")
  atualizadoEm        DateTime             @default(now()) @updatedAt @map("atualizado_em")
  senhaTemporaria     Boolean              @default(true) @map("senha_temporaria")
  papel               PapelGestor?
  auditLogs           AuditLog[]
  backoffice          Backoffice?
  comercial           Comercial?
  consultorPf         ConsultorPf?
  gestor              Gestor?
  lideranca           Lideranca?
  parceiro            Parceiro?
  passwordResetTokens PasswordResetToken[]

  @@map("usuarios")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  usuarioId  String?  @map("usuario_id") @db.Uuid
  acao       String   @db.VarChar(100)
  entidade   String   @db.VarChar(100)
  entidadeId String?  @map("entidade_id") @db.Uuid
  detalhes   Json?
  criadoEm   DateTime @default(now()) @map("criado_em")
  usuario    Usuario? @relation(fields: [usuarioId], references: [id])

  @@map("audit_logs")
}

model PasswordResetToken {
  id                       String                  @id @default(uuid()) @db.Uuid
  usuarioId                String?                 @map("usuario_id") @db.Uuid
  token                    String                  @unique @db.VarChar(255)
  expiresAt                DateTime                @map("expires_at")
  criadoEm                 DateTime                @default(now()) @map("criado_em")
  usuario                  Usuario?                @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([usuarioId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Backoffice {
  id                        String               @id @default(uuid()) @db.Uuid
  usuarioId                 String               @unique @map("usuario_id") @db.Uuid
  nome                      String               @db.VarChar(255)
  cpf                       String               @unique @db.VarChar(14)
  percentualComissaoDefault Decimal              @default(5.00) @map("percentual_comissao_default") @db.Decimal(5, 2)
  percentualComissaoMax     Decimal              @default(100.00) @map("percentual_comissao_max") @db.Decimal(5, 2)
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @default(now()) @updatedAt @map("updated_at")
  usuario                   Usuario              @relation(fields: [usuarioId], references: [id])
  ciclosPontos              CicloPontos[]
  comerciais                Comercial[]
  configuracoesPontos       ConfiguracaoPontos[]
  parceiros                 Parceiro[]
  premios                   Premio[]
  regrasComerciais          RegraComercial[]
  regrasGestores            RegraGestor[]
  setores                  Setor[]

  @@map("backoffices")
}

model Lideranca {
  id           String          @id @default(uuid()) @db.Uuid
  usuarioId    String          @unique @map("usuario_id") @db.Uuid
  nome         String          @db.VarChar(255)
  cpf          String          @unique @db.VarChar(14)
  backofficeId String          @map("backoffice_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  tipo         TipoLideranca
  status       StatusUsuario   @default(ATIVO)
  comerciais   Comercial[]
  consultorPfs ConsultorPf[]
  gestores     Gestor[]
  usuario      Usuario         @relation(fields: [usuarioId], references: [id])
  metas        MetaLideranca[]

  @@index([backofficeId])
  @@index([tipo])
  @@map("liderancas")
}

model Gestor {
  id                 String           @id @default(uuid()) @db.Uuid
  usuarioId          String           @unique @map("usuario_id") @db.Uuid
  nome               String           @db.VarChar(255)
  cpf                String           @unique @db.VarChar(14)
  liderancaId        String           @map("lideranca_id") @db.Uuid
  percentualComissao Decimal          @default(0) @map("percentual_comissao") @db.Decimal(5, 2)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  status             StatusUsuario    @default(ATIVO)
  lideranca          Lideranca        @relation(fields: [liderancaId], references: [id])
  usuario            Usuario          @relation(fields: [usuarioId], references: [id])
  parceiros          Parceiro[]
  procedimentos      ProcedimentoPF[]

  @@index([liderancaId])
  @@map("gestores")
}

model Comercial {
  id                 String              @id @default(uuid()) @db.Uuid
  usuarioId          String              @unique @map("usuario_id") @db.Uuid
  nome               String              @db.VarChar(255)
  cpf                String              @unique @db.VarChar(14)
  percentualComissao Decimal             @default(0) @map("percentual_comissao") @db.Decimal(5, 2)
  status             StatusUsuario       @default(ATIVO)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  funcao             FuncaoComercial?
  liderancaId        String?             @map("lideranca_id") @db.Uuid
  tipoLideranca      TipoLideranca?
  backofficeId       String?             @map("backoffice_id") @db.Uuid
  backoffice         Backoffice?         @relation(fields: [backofficeId], references: [id], onDelete: Restrict)
  lideranca          Lideranca?          @relation(fields: [liderancaId], references: [id], onDelete: Restrict)
  usuario            Usuario             @relation(fields: [usuarioId], references: [id])
  comissoes          ComissaoComercial[]
  metas              MetaComercial[]
  parceiros          Parceiro[]
  procedimentos      ProcedimentoPF[]

  @@index([liderancaId])
  @@index([backofficeId])
  @@map("comerciais")
}

model ConsultorPf {
  id            String             @id @default(uuid()) @db.Uuid
  usuarioId     String             @unique @map("usuario_id") @db.Uuid
  nome          String             @db.VarChar(255)
  cpf           String             @unique @db.VarChar(14)
  liderancaId   String             @map("lideranca_id") @db.Uuid
  status        StatusUsuario      @default(ATIVO)
  criadoEm      DateTime           @default(now()) @map("criado_em")
  atualizadoEm  DateTime           @default(now()) @updatedAt @map("atualizado_em")
  setores       ConsultorPfSetor[]
  lideranca     Lideranca          @relation(fields: [liderancaId], references: [id])
  usuario       Usuario            @relation(fields: [usuarioId], references: [id])
  metas         MetaConsultorPf[]
  procedimentos ProcedimentoPF[]

  @@index([liderancaId])
  @@map("consultores_pf")
}

model Setor {
  id           String             @id @default(uuid()) @db.Uuid
  backofficeId String?            @map("backoffice_id") @db.Uuid
  nome         String             @db.VarChar(100)
  descricao    String?            @db.VarChar(255)
  ativo        Boolean            @default(true)
  criadoEm     DateTime           @default(now()) @map("criado_em")
  atualizadoEm DateTime           @default(now()) @updatedAt @map("atualizado_em")
  consultores  ConsultorPfSetor[]
  metas        MetaConsultorPf[]
  backoffice   Backoffice?        @relation(fields: [backofficeId], references: [id], onDelete: Cascade)

  @@unique([backofficeId, nome])
  @@index([backofficeId])
  @@map("setores")
}

model ConsultorPfSetor {
  id            String      @id @default(uuid()) @db.Uuid
  consultorPfId String      @map("consultor_pf_id") @db.Uuid
  setorId       String      @map("setor_id") @db.Uuid
  criadoEm      DateTime    @default(now()) @map("criado_em")
  consultorPf   ConsultorPf @relation(fields: [consultorPfId], references: [id], onDelete: Cascade)
  setor         Setor       @relation(fields: [setorId], references: [id], onDelete: Cascade)

  @@unique([consultorPfId, setorId])
  @@index([consultorPfId])
  @@index([setorId])
  @@map("consultor_pf_setores")
}

model MetaComercial {
  id            String    @id @default(uuid()) @db.Uuid
  comercialId   String    @map("comercial_id") @db.Uuid
  mesReferencia String    @map("mes_referencia")
  valorMeta     Decimal   @default(0) @map("valor_meta") @db.Decimal(12, 2)
  valorAtingido Decimal   @default(0) @map("valor_atingido") @db.Decimal(12, 2)
  valorComissao Decimal   @default(0) @map("valor_comissao") @db.Decimal(12, 2)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  comercial     Comercial @relation(fields: [comercialId], references: [id], onDelete: Cascade)

  @@unique([comercialId, mesReferencia])
  @@index([comercialId])
  @@map("metas_comerciais")
}

model MetaConsultorPf {
  id            String      @id @default(uuid()) @db.Uuid
  consultorPfId String      @map("consultor_pf_id") @db.Uuid
  setorId       String?     @map("setor_id") @db.Uuid
  mesReferencia String      @map("mes_referencia")
  valorMeta     Decimal     @default(0) @map("valor_meta") @db.Decimal(12, 2)
  valorAtingido Decimal     @default(0) @map("valor_atingido") @db.Decimal(12, 2)
  criadoPorId   String?     @map("criado_por_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at")
  consultorPf   ConsultorPf @relation(fields: [consultorPfId], references: [id], onDelete: Cascade)
  setor         Setor?      @relation(fields: [setorId], references: [id], onDelete: SetNull)

  @@unique([consultorPfId, setorId, mesReferencia])
  @@index([consultorPfId])
  @@index([setorId])
  @@map("metas_consultores_pf")
}

model MetaLideranca {
  id            String    @id @default(uuid()) @db.Uuid
  liderancaId   String    @map("lideranca_id") @db.Uuid
  mesReferencia String    @map("mes_referencia")
  valorMeta     Decimal   @default(0) @map("valor_meta") @db.Decimal(12, 2)
  valorAtingido Decimal   @default(0) @map("valor_atingido") @db.Decimal(12, 2)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  lideranca     Lideranca @relation(fields: [liderancaId], references: [id], onDelete: Cascade)

  @@unique([liderancaId, mesReferencia])
  @@index([liderancaId])
  @@map("metas_liderancas")
}

model ComissaoComercial {
  id            String         @id @default(uuid()) @db.Uuid
  comercialId   String         @map("comercial_id") @db.Uuid
  mesReferencia String         @map("mes_referencia")
  valorVendas   Decimal        @default(0) @map("valor_vendas") @db.Decimal(12, 2)
  valorComissao Decimal        @default(0) @map("valor_comissao") @db.Decimal(12, 2)
  status        StatusComissao @default(CALCULADA)
  dataPagamento DateTime?      @map("data_pagamento")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  comercial     Comercial      @relation(fields: [comercialId], references: [id], onDelete: Cascade)

  @@unique([comercialId, mesReferencia])
  @@index([comercialId])
  @@map("comissoes_comerciais")
}

model RegraComercial {
  id                String     @id @default(uuid()) @db.Uuid
  backofficeId      String     @unique @map("backoffice_id") @db.Uuid
  cartaoAcessoSaude Decimal    @default(0) @map("cartao_acesso_saude") @db.Decimal(5, 2)
  cireAtivo         Decimal    @default(0) @map("cire_ativo") @db.Decimal(5, 2)
  cireReceptivo     Decimal    @default(0) @map("cire_receptivo") @db.Decimal(5, 2)
  franchisingAcesso Decimal    @default(0) @map("franchising_acesso") @db.Decimal(5, 2)
  franchisingCartao Decimal    @default(0) @map("franchising_cartao") @db.Decimal(5, 2)
  unidade           Decimal    @default(0) @map("unidade") @db.Decimal(5, 2)
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  backoffice        Backoffice @relation(fields: [backofficeId], references: [id], onDelete: Cascade)

  @@index([backofficeId])
  @@map("regras_comerciais")
}

model RegraGestor {
  id                    String     @id @default(uuid()) @db.Uuid
  backofficeId          String     @unique @map("backoffice_id") @db.Uuid
  gerenteCire           Decimal    @default(0) @map("gerente_cire") @db.Decimal(5, 2)
  supervisorAtivo       Decimal    @default(0) @map("supervisor_ativo") @db.Decimal(5, 2)
  supervisorReceptivo   Decimal    @default(0) @map("supervisor_receptivo") @db.Decimal(5, 2)
  supervisorFranquia    Decimal    @default(0) @map("supervisor_franquia") @db.Decimal(5, 2)
  supervisorAtendimento Decimal    @default(0) @map("supervisor_atendimento") @db.Decimal(5, 2)
  gerenteAtendimento    Decimal    @default(0) @map("gerente_atendimento") @db.Decimal(5, 2)
  supervisorComercial   Decimal    @default(0) @map("supervisor_comercial") @db.Decimal(5, 2)
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")
  backoffice            Backoffice @relation(fields: [backofficeId], references: [id], onDelete: Cascade)

  @@index([backofficeId])
  @@map("regras_gestores")
}

model Parceiro {
  id                          String               @id @default(uuid()) @db.Uuid
  usuarioId                   String               @unique @map("usuario_id") @db.Uuid
  nome                        String               @db.VarChar(255)
  cpf                         String               @unique @db.VarChar(14)
  pixChave                    String?              @map("pix_chave") @db.VarChar(100)
  status                      StatusParceiro       @default(ATIVO)
  desligadoEm                 DateTime?            @map("desligado_em")
  createdAt                   DateTime             @default(now()) @map("created_at")
  updatedAt                   DateTime             @updatedAt @map("updated_at")
  periodicidadeCicloEscolhida PeriodicidadeCiclo?  @map("periodicidade_ciclo_escolhida")
  comercialId                 String?              @map("comercial_id") @db.Uuid
  gestorId                    String?              @map("gestor_id") @db.Uuid
  backofficeId                String?              @map("backoffice_id") @db.Uuid
  indicacoes                  Indicado[]
  movimentacoesPontos         MovimentacaoPontos[]
  backoffice                  Backoffice?          @relation(fields: [backofficeId], references: [id], onDelete: Restrict)
  comercial                   Comercial?           @relation(fields: [comercialId], references: [id])
  gestor                      Gestor?              @relation(fields: [gestorId], references: [id])
  usuario                     Usuario              @relation(fields: [usuarioId], references: [id])
  primeiraAcss                PrimeiraAcss[]
  procedimentos               ProcedimentoPF[]
  rankingPosicoes             RankingPosicao[]
  solicitacoesResgate         SolicitacaoResgate[]

  @@index([comercialId])
  @@index([gestorId])
  @@index([backofficeId])
  @@map("parceiros")
}

model Indicado {
  id             String           @id @default(uuid()) @db.Uuid
  nome           String           @db.VarChar(255)
  cpf            String           @unique @db.VarChar(14)
  telefone       String?          @db.VarChar(20)
  status         StatusIndicado   @default(ATIVO)
  parceiroId     String           @map("parceiro_id") @db.Uuid
  desvinculadoEm DateTime?        @map("desvinculado_em")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  parceiro       Parceiro         @relation(fields: [parceiroId], references: [id])
  procedimentos  ProcedimentoPF[]

  @@index([cpf])
  @@index([parceiroId])
  @@map("indicados")
}

model UploadPlanilhaBackoffice {
  id              String              @id @default(uuid()) @db.Uuid
  nomeArquivo     String              @map("nome_arquivo") @db.VarChar(255)
  mesReferencia   String              @map("mes_referencia")
  status          StatusUpload        @default(PROCESSANDO)
  totalRows       Int                 @default(0) @map("total_rows")
  processedRows   Int                 @default(0) @map("processed_rows")
  rejectedRows    Int                 @default(0) @map("rejected_rows")
  orphanedRows    Int                 @default(0) @map("orphaned_rows")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  backofficeId    String              @default(dbgenerated("'00000000-0000-0000-0000-000000000000'::uuid")) @map("backoffice_id") @db.Uuid
  conteudoArquivo Bytes?              @map("conteudo_arquivo")
  tamanhoArquivo  Int?                @map("tamanho_arquivo")
  procedimentos   ProcedimentoPF[]
  linhasRaw       ProcedimentoPFRaw[]

  @@index([backofficeId])
  @@index([mesReferencia])
  @@map("uploads_planilha_backoffice")
}

model ProcedimentoPFRaw {
  id              String                   @id @default(uuid()) @db.Uuid
  uploadId        String                   @map("upload_id") @db.Uuid
  linhaOriginal   Int                      @map("linha_original")
  dadosOriginais  Json                     @map("dados_originais")
  valido          Boolean                  @default(false)
  motivoRejeicao  String?                  @map("motivo_rejeicao") @db.VarChar(500)
  orfao           Boolean                  @default(false)
  motivoOrfao     String?                  @map("motivo_orfao") @db.VarChar(500)
  createdAt       DateTime                 @default(now()) @map("created_at")
  upload          UploadPlanilhaBackoffice @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([uploadId])
  @@index([valido])
  @@index([orfao])
  @@map("procedimentos_pf_raw")
}

model ProcedimentoPF {
  id               String                   @id @default(uuid()) @db.Uuid
  dataReferencia   DateTime                 @map("data_referencia")
  dataPagamento    DateTime                 @map("data_pagamento")
  formaPagamento   String                   @map("forma_pagamento") @db.VarChar(50)
  totalPago        Decimal                  @map("total_pago") @db.Decimal(10, 2)
  paciente         String                   @db.VarChar(255)
  procedimento     String                   @db.VarChar(255)
  cpf              String                   @db.VarChar(14)
  tipoProcedimento String                   @map("tipo_procedimento") @db.VarChar(50)
  unidade          String                   @db.VarChar(100)
  indicadoId       String?                  @map("indicado_id") @db.Uuid
  parceiroId       String?                  @map("parceiro_id") @db.Uuid
  uploadId         String                   @map("upload_id") @db.Uuid
  valorComissao    Decimal                  @default(0) @map("valor_comissao") @db.Decimal(10, 2)
  statusComissao   StatusProcedimento       @default(PENDENTE) @map("status_comissao")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  comercialId      String?                  @map("comercial_id") @db.Uuid
  gestorId         String?                  @map("gestor_id") @db.Uuid
  consultorPfId    String?                  @map("consultor_pf_id") @db.Uuid
  comercial        Comercial?               @relation(fields: [comercialId], references: [id])
  consultorPf      ConsultorPf?             @relation(fields: [consultorPfId], references: [id])
  gestor           Gestor?                  @relation(fields: [gestorId], references: [id])
  indicado         Indicado?                @relation(fields: [indicadoId], references: [id])
  parceiro         Parceiro?                @relation(fields: [parceiroId], references: [id])
  upload           UploadPlanilhaBackoffice @relation(fields: [uploadId], references: [id])

  @@unique([dataReferencia, cpf, procedimento, unidade])
  @@index([cpf])
  @@index([indicadoId])
  @@index([parceiroId])
  @@index([comercialId])
  @@index([gestorId])
  @@index([consultorPfId])
  @@index([consultorPfId, dataReferencia])
  @@index([uploadId])
  @@map("procedimentos_pf")
}

model PrimeiraAcss {
  id         String    @id @default(uuid()) @db.Uuid
  token      String    @unique
  parceiroId String?   @map("parceiro_id") @db.Uuid
  expiresAt  DateTime
  revoked    Boolean   @default(false)
  createdAt  DateTime  @default(now()) @map("created_at")
  parceiro   Parceiro? @relation(fields: [parceiroId], references: [id])

  @@index([token])
  @@map("primeira_acss")
}

model BaseClientesAcessoSaude {
  cpf String @id @db.VarChar(11)

  @@map("base_clientes_acesso_saude")
}

model ConfiguracaoPontos {
  id                 String             @id @default(uuid()) @db.Uuid
  valorPorPonto      Decimal            @map("valor_por_ponto") @db.Decimal(10, 2)
  tipoArredondamento TipoArredondamento @default(PADRAO) @map("tipo_arredondamento")
  vigenteDesde       DateTime           @map("vigente_desde")
  vigenteAte         DateTime?          @map("vigente_ate")
  criadoPor          String?            @map("criado_por") @db.Uuid
  criadoEm           DateTime           @default(now()) @map("criado_em")
  atualizadoEm       DateTime           @updatedAt @map("atualizado_em")
  backofficeId       String             @default(dbgenerated("'00000000-0000-0000-0000-000000000000'::uuid")) @map("backoffice_id") @db.Uuid
  backoffice         Backoffice         @relation(fields: [backofficeId], references: [id])

  @@index([backofficeId])
  @@index([vigenteDesde])
  @@map("configuracoes_pontos")
}

model CicloPontos {
  id                    String               @id @default(uuid()) @db.Uuid
  nome                  String               @db.VarChar(255)
  inicioAcumuloEm       DateTime             @map("inicio_acumulo_em")
  fimAcumuloEm          DateTime             @map("fim_acumulo_em")
  fimResgateEm          DateTime             @map("fim_resgate_em")
  status                StatusCicloPontos    @default(EM_ANDAMENTO)
  processadoExpiracaoEm DateTime?            @map("processado_expiracao_em")
  criadoEm              DateTime             @default(now()) @map("criado_em")
  atualizadoEm          DateTime             @updatedAt @map("atualizado_em")
  periodicidade         PeriodicidadeCiclo   @default(ANUAL) @map("periodicidade")
  backofficeId          String               @default(dbgenerated("'00000000-0000-0000-0000-000000000000'::uuid")) @map("backoffice_id") @db.Uuid
  backoffice            Backoffice           @relation(fields: [backofficeId], references: [id])
  movimentacoes         MovimentacaoPontos[]
  rankingSnapshots      RankingSnapshot[]
  solicitacoesResgate   SolicitacaoResgate[]

  @@index([backofficeId, status])
  @@index([backofficeId])
  @@index([status])
  @@map("ciclos_pontos")
}

model MovimentacaoPontos {
  id                             String                   @id @default(uuid()) @db.Uuid
  parceiroId                     String                   @map("parceiro_id") @db.Uuid
  cicloPontosId                  String                   @map("ciclo_pontos_id") @db.Uuid
  tipo                           TipoMovimentacaoPontos
  origem                         OrigemMovimentacaoPontos
  quantidade                     Int
  referenciaProcedimentoId       String?                  @map("referencia_procedimento_id") @db.Uuid
  referenciaSolicitacaoResgateId String?                  @map("referencia_solicitacao_resgate_id") @db.Uuid
  configuracaoPontosId           String?                  @map("configuracao_pontos_id") @db.Uuid
  observacao                     String?
  criadoPor                      String?                  @map("criado_por") @db.Uuid
  criadoEm                       DateTime                 @default(now()) @map("criado_em")
  descricao                      String?
  cicloPontos                    CicloPontos              @relation(fields: [cicloPontosId], references: [id])
  parceiro                       Parceiro                 @relation(fields: [parceiroId], references: [id])

  @@index([parceiroId])
  @@index([cicloPontosId])
  @@index([origem])
  @@index([referenciaProcedimentoId])
  @@index([referenciaSolicitacaoResgateId])
  @@map("movimentacoes_pontos")
}

model RankingSnapshot {
  id            String           @id @default(uuid()) @db.Uuid
  cicloPontosId String           @map("ciclo_pontos_id") @db.Uuid
  referenciaMes String           @map("referencia_mes") @db.VarChar(7)
  geradoEm      DateTime         @default(now()) @map("gerado_em")
  posicoes      RankingPosicao[]
  cicloPontos   CicloPontos      @relation(fields: [cicloPontosId], references: [id])

  @@unique([cicloPontosId, referenciaMes])
  @@index([cicloPontosId])
  @@map("ranking_snapshots")
}

model RankingPosicao {
  id                String          @id @default(uuid()) @db.Uuid
  rankingSnapshotId String          @map("ranking_snapshot_id") @db.Uuid
  parceiroId        String          @map("parceiro_id") @db.Uuid
  posicao           Int
  pontosAcumulados  Int             @map("pontos_acumulados")
  parceiro          Parceiro        @relation(fields: [parceiroId], references: [id])
  rankingSnapshot   RankingSnapshot @relation(fields: [rankingSnapshotId], references: [id])

  @@unique([rankingSnapshotId, parceiroId])
  @@index([rankingSnapshotId])
  @@index([parceiroId])
  @@map("ranking_posicoes")
}

model Premio {
  id           String               @id @default(uuid()) @db.Uuid
  backofficeId String               @map("backoffice_id") @db.Uuid
  nome         String               @db.VarChar(255)
  codigo       String               @db.VarChar(50)
  tipo         String               @db.VarChar(50)
  descricao    String
  custoPontos  Int                  @map("custo_pontos")
  ativo        Boolean              @default(true)
  imagemUrl    String?              @map("imagem_url")
  criadoEm     DateTime             @default(now()) @map("criado_em")
  atualizadoEm DateTime             @updatedAt @map("atualizado_em")
  backoffice   Backoffice           @relation(fields: [backofficeId], references: [id], onDelete: Restrict)
  solicitacoes SolicitacaoResgate[]

  @@index([backofficeId])
  @@index([ativo])
  @@map("premios")
}

model SolicitacaoResgate {
  id              String                   @id @default(uuid()) @db.Uuid
  parceiroId      String                   @map("parceiro_id") @db.Uuid
  premioId        String                   @map("premio_id") @db.Uuid
  cicloPontosId   String                   @map("ciclo_pontos_id") @db.Uuid
  pontosDebitados Int                      @map("pontos_debitados")
  status          StatusSolicitacaoResgate @default(SOLICITADO)
  solicitadoEm    DateTime                 @default(now()) @map("solicitado_em")
  processadoPor   String?                  @map("processado_por") @db.Uuid
  processadoEm    DateTime?                @map("processado_em")
  entregueEm      DateTime?                @map("entregue_em")
  canceladoEm     DateTime?                @map("cancelado_em")
  observacao      String?
  cicloPontos     CicloPontos              @relation(fields: [cicloPontosId], references: [id])
  parceiro        Parceiro                 @relation(fields: [parceiroId], references: [id])
  premio          Premio                   @relation(fields: [premioId], references: [id])

  @@index([parceiroId])
  @@index([premioId])
  @@index([cicloPontosId])
  @@index([status])
  @@map("solicitacoes_resgate")
}

