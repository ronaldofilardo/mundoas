{
  "name": "asa-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "vercel-build": "pnpm build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:migrate": "pnpm --filter @asa/database prisma migrate dev",
    "db:migrate:prod": "pnpm --filter @asa/database prisma migrate deploy",
    "db:seed": "pnpm --filter @asa/database prisma db seed",
    "db:studio": "pnpm --filter @asa/database prisma studio",
    "setup": "pnpm install && pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.1"
  },
  "packageManager": "pnpm@9.0.0"
}
