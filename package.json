{
  "name": "asa-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "vercel-build": "pnpm build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:migrate": "pnpm --filter @asa/database prisma migrate dev",
    "db:migrate:prod": "pnpm --filter @asa/database prisma migrate deploy",
    "db:seed": "pnpm --filter @asa/database prisma db seed",
    "db:studio": "pnpm --filter @asa/database prisma studio",
    "setup": "pnpm install && pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.1"
  },
  "packageManager": "pnpm@9.0.0"
}
